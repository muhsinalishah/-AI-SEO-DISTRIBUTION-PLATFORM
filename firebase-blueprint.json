{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user account information and subscription status.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "subscriptionTier": { "type": "string", "enum": ["free", "pro", "agency", "enterprise"] },
        "credits": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "apiKeys": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["userId", "email"]
    },
    "Project": {
      "title": "SEO Project",
      "description": "A project container for tracking SEO distribution and assets.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "targetUrls": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "archived"] }
      },
      "required": ["projectId", "ownerId", "name"]
    },
    "Content": {
      "title": "Generated Content",
      "description": "AI-generated text artifacts for SEO purposes.",
      "type": "object",
      "properties": {
        "contentId": { "type": "string" },
        "projectId": { "type": "string" },
        "type": { "type": "string", "enum": ["article", "parasite_seo", "web20", "reddit_post", "backlink_context"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "metaDescription": { "type": "string" },
        "keywordsUsed": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["draft", "published"] }
      },
      "required": ["contentId", "projectId", "type"]
    },
    "Backlink": {
      "title": "Generated Backlink",
      "description": "A record of a backlink created by the platform.",
      "type": "object",
      "properties": {
        "linkId": { "type": "string" },
        "projectId": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "targetUrl": { "type": "string" },
        "anchorText": { "type": "string" },
        "type": { "type": "string", "enum": ["contextual", "profile", "comment"] },
        "qualityScore": { "type": "number" },
        "indexed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["linkId", "projectId", "sourceUrl", "targetUrl"]
    },
    "IndexingRequest": {
      "title": "Indexing Request",
      "description": "A request to accelerate indexing of a URL.",
      "type": "object",
      "properties": {
        "requestId": { "type": "string" },
        "userId": { "type": "string" },
        "url": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "failed"] },
        "methods": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "userId", "url"]
    },
    "ExpiredDomain": {
      "title": "Expired Domain",
      "description": "A discovered expired domain with SEO potential.",
      "type": "object",
      "properties": {
        "domain": { "type": "string" },
        "da": { "type": "number" },
        "pa": { "type": "number" },
        "spamScore": { "type": "number" },
        "category": { "type": "string" },
        "foundAt": { "type": "string", "format": "date-time" }
      },
      "required": ["domain"]
    },
    "AutomatedTask": {
      "title": "Automated Task",
      "description": "A background task for the distribution engine.",
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "userId": { "type": "string" },
        "module": { "type": "string" },
        "payload": { "type": "object" },
        "status": { "type": "string", "enum": ["queued", "running", "completed", "failed"] },
        "attempts": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["taskId", "userId", "module"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Global user profiles" },
    "/projects/{projectId}": { "schema": "Project", "description": "All SEO projects" },
    "/projects/{projectId}/content/{contentId}": { "schema": "Content", "description": "Content belonging to a project" },
    "/projects/{projectId}/backlinks/{linkId}": { "schema": "Backlink", "description": "Backlinks associated with a project" },
    "/indexing_requests/{requestId}": { "schema": "IndexingRequest", "description": "Indexing queue" },
    "/expired_domains/{domainId}": { "schema": "ExpiredDomain", "description": "Global cache of expired domains" },
    "/tasks/{taskId}": { "schema": "AutomatedTask", "description": "Background worker queue" }
  }
}
